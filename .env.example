# ============================================================
# AEIMPS Environment Configuration
# Copy to .env and fill in your values
# ============================================================

# ─── Core ────────────────────────────────────────────────────
ENVIRONMENT=development
LOG_LEVEL=INFO
SECRET_KEY=change-me-to-a-random-64-char-secret-key-in-production

# ─── PostgreSQL ──────────────────────────────────────────────
POSTGRES_DB=aeimps
POSTGRES_USER=aeimps
POSTGRES_PASSWORD=aeimps_secret

# ─── Redis ───────────────────────────────────────────────────
REDIS_PASSWORD=redis_secret

# ─── Qdrant ──────────────────────────────────────────────────
# No auth for local dev; configure API key for production
QDRANT_API_KEY=

# ─── Neo4j ───────────────────────────────────────────────────
NEO4J_USER=neo4j
NEO4J_PASSWORD=neo4j_secret

# ─── AI / LLM ────────────────────────────────────────────────
# Required for agent workflows and evaluation
ANTHROPIC_API_KEY=sk-ant-your-key-here

# ─── Model Configuration ─────────────────────────────────────
# Set MOCK_MODELS=true to use random vectors (no GPU needed for dev)
MOCK_MODELS=false
EMBEDDING_MODEL=BAAI/bge-large-en-v1.5
EMBEDDING_DIM=1024
SPARSE_MODEL=BAAI/bge-m3
RERANKER_MODEL=BAAI/bge-reranker-v2-m3
VISION_MODEL=Qwen/Qwen2-VL-7B-Instruct

# ─── Ingestion ───────────────────────────────────────────────
MAX_FILE_SIZE_MB=100
RAW_FILES_PATH=/data/raw
MODEL_CACHE_PATH=/data/models

# ─── Observability ───────────────────────────────────────────
GRAFANA_USER=admin
GRAFANA_PASSWORD=grafana_secret
OTEL_SERVICE_NAME=aeimps
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4317

# ─── API Rate Limiting ────────────────────────────────────────
DEFAULT_RATE_LIMIT_RPM=60

# ─── Agent Configuration ─────────────────────────────────────
AGENT_MAX_ITERATIONS=8
AGENT_MIN_CONFIDENCE=0.65
AGENT_SESSION_TTL_HOURS=24

# ─── Evaluation ──────────────────────────────────────────────
EVAL_MIN_FAITHFULNESS=0.75
EVAL_MIN_OVERALL=0.65
